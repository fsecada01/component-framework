{% extends "default/frame.html.jinja2" %}

{#
  Custom frame template for component-framework docs.

  Aesthetic: Terminal Brutalism — near-black ground, chartreuse green on IBM Plex Mono,
  electric-orange accents, cyan secondary.  Matches docs/index.html and the root
  version-listing page generated by docs/update_gh_pages.py.

  Changes vs default pdoc template:
    1. IBM Plex Mono injected via <link> in head (not @import inside style).
    2. Full dark theme overriding every pdoc selector.
    3. Version-switcher bar rendered as a position:fixed full-width header
       (even though it lives in the {% block nav %} DOM node, CSS lifts it out).
    4. highlight.js tokens remapped to terminal palette.
    5. Scanline overlay for texture.
    6. Version/status badge auto-detected from URL path.
#}

{# ── <head>: font preload ──────────────────────────────────────────────────── #}
{% block head %}
{{ super() }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
{% endblock head %}

{# ── CSS overrides ─────────────────────────────────────────────────────────── #}
{% block style %}
{{ super() }}
<style>
/* ── Design tokens ────────────────────────────────────────────────────── */
:root {
  --cfx-bg:         #0a0c0b;
  --cfx-panel:      #0f1210;
  --cfx-border:     #1e2b22;
  --cfx-border-lit: #2e4838;
  --cfx-green:      #7fff5f;
  --cfx-orange:     #ff6e27;
  --cfx-cyan:       #1dfcf0;
  --cfx-dim:        #3a5043;
  --cfx-mid:        #698075;
  --cfx-text:       #c8d9cc;
  --cfx-white:      #e8f0ea;
  --cfx-code-bg:    #111813;
  --cfx-mono:       'IBM Plex Mono', 'Courier New', monospace;
  --cfx-bar-h:      40px;

  /* pdoc override — sets the page background */
  --pdoc-background: var(--cfx-bg);
}

/* ── Scanline texture ─────────────────────────────────────────────────── */
body::after {
  content: '';
  position: fixed;
  inset: 0;
  background: repeating-linear-gradient(
    to bottom,
    transparent 0,
    transparent 3px,
    rgba(0, 0, 0, 0.10) 4px
  );
  pointer-events: none;
  z-index: 9000;
}

/* ── Base reset ───────────────────────────────────────────────────────── */
html { scroll-behavior: smooth; }

body {
  background: var(--cfx-bg);
  color: var(--cfx-text);
  font-family: var(--cfx-mono);
  padding-top: var(--cfx-bar-h);   /* clear the fixed version bar */
}

/* ── Scrollbar ────────────────────────────────────────────────────────── */
::-webkit-scrollbar { width: 5px; height: 5px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: var(--cfx-border-lit); border-radius: 3px; }
::-webkit-scrollbar-thumb:hover { background: var(--cfx-dim); }
* { scrollbar-width: thin; scrollbar-color: var(--cfx-border-lit) transparent; }

/* ═══════════════════════════════════════════════════════════════════════
   VERSION BAR  — pulled out of sidebar flow with position:fixed
   ═══════════════════════════════════════════════════════════════════════ */
#cfx-version-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: var(--cfx-bar-h);
  z-index: 1000;
  display: flex;
  align-items: center;
  gap: 0;
  padding: 0 1.25rem;
  background: var(--cfx-panel);
  border-bottom: 1px solid var(--cfx-border);
  font-family: var(--cfx-mono);
  font-size: 11px;
  color: var(--cfx-dim);
  white-space: nowrap;
  overflow: hidden;
}

/* Logo */
#cfx-version-bar .cfx-logo {
  color: var(--cfx-green);
  font-weight: 600;
  font-size: 12px;
  letter-spacing: 0.03em;
  text-decoration: none;
  margin-right: 1rem;
  flex-shrink: 0;
}
#cfx-version-bar .cfx-logo::before {
  content: "> ";
  color: var(--cfx-orange);
}

/* Status badge */
#cfx-version-bar .cfx-badge {
  font-size: 9px;
  letter-spacing: 0.12em;
  border: 1px solid var(--cfx-orange);
  color: var(--cfx-orange);
  padding: 0 5px;
  border-radius: 2px;
  opacity: 0.85;
  margin-right: 1rem;
  flex-shrink: 0;
}
#cfx-version-bar .cfx-badge.is-dev    { color: var(--cfx-cyan);   border-color: var(--cfx-cyan); }
#cfx-version-bar .cfx-badge.is-stable { color: var(--cfx-green);  border-color: var(--cfx-green); }

/* Separator */
#cfx-version-bar .cfx-sep {
  color: var(--cfx-border-lit);
  margin: 0 0.75rem;
  flex-shrink: 0;
}

/* Version label + select */
#cfx-version-bar .cfx-ver-label {
  color: var(--cfx-dim);
  margin-right: 0.4rem;
  flex-shrink: 0;
}
#cfx-version-bar select {
  font-family: var(--cfx-mono);
  font-size: 11px;
  color: var(--cfx-text);
  background: var(--cfx-bg);
  border: 1px solid var(--cfx-border-lit);
  border-radius: 2px;
  padding: 2px 8px 2px 6px;
  cursor: pointer;
  outline: none;
  appearance: none;
  -webkit-appearance: none;
  flex-shrink: 0;
  max-width: 160px;
}
#cfx-version-bar select:focus { border-color: var(--cfx-green); }

/* Right-aligned links */
#cfx-version-bar .cfx-links {
  margin-left: auto;
  display: flex;
  gap: 1.25rem;
  align-items: center;
  flex-shrink: 0;
}
#cfx-version-bar .cfx-links a {
  color: var(--cfx-mid);
  text-decoration: none;
  font-size: 10px;
  letter-spacing: 0.06em;
  transition: color 0.12s;
}
#cfx-version-bar .cfx-links a:hover { color: var(--cfx-green); }

/* ═══════════════════════════════════════════════════════════════════════
   SIDEBAR
   ═══════════════════════════════════════════════════════════════════════ */
nav#sidebar {
  background: var(--cfx-panel);
  border-right: 1px solid var(--cfx-border);
  font-family: var(--cfx-mono);
  /* keep sticky below the fixed bar */
  top: var(--cfx-bar-h);
  max-height: calc(100vh - var(--cfx-bar-h));
}

nav#sidebar a { color: var(--cfx-mid); text-decoration: none; }
nav#sidebar a:hover,
nav#sidebar a:focus { color: var(--cfx-green); }

/* section labels */
nav#sidebar h2, nav#sidebar h3 {
  font-family: var(--cfx-mono);
  font-size: 9px;
  color: var(--cfx-dim);
  letter-spacing: 0.18em;
  text-transform: uppercase;
  margin: 1rem 0 0.35rem;
}

/* search */
nav#sidebar input[type=search] {
  font-family: var(--cfx-mono);
  font-size: 11px;
  background: rgba(255,255,255,0.03);
  color: var(--cfx-text);
  border: 1px solid var(--cfx-border);
  border-radius: 2px;
  padding: 4px 8px;
  outline: none;
  width: 100%;
  box-sizing: border-box;
}
nav#sidebar input[type=search]:focus { border-color: var(--cfx-green); }
nav#sidebar input[type=search]::placeholder { color: var(--cfx-dim); }

/* list items */
nav#sidebar ul { list-style: none; padding: 0; margin: 0; }
nav#sidebar li { margin: 0; }
nav#sidebar li > a {
  display: block;
  padding: 0.25rem 1rem;
  font-size: 12px;
  border-left: 2px solid transparent;
  transition: color 0.1s, border-color 0.1s, background 0.1s;
}
nav#sidebar li > a:hover {
  color: var(--cfx-green);
  border-left-color: var(--cfx-green);
  background: rgba(127,255,95,0.04);
}

nav#sidebar .module-list-button {
  color: var(--cfx-orange);
  border-color: var(--cfx-border-lit);
  background: transparent;
  font-family: var(--cfx-mono);
  font-size: 11px;
}

/* ═══════════════════════════════════════════════════════════════════════
   MAIN CONTENT
   ═══════════════════════════════════════════════════════════════════════ */
main#content {
  background: var(--cfx-bg);
}

/* ── Headings ─────────────────────────────────────────────────────────── */
.pdoc h1 {
  font-family: var(--cfx-mono);
  color: var(--cfx-white);
  font-size: 1.5rem;
  font-weight: 600;
  border-bottom: 1px solid var(--cfx-border);
  padding-bottom: 0.65rem;
  margin-bottom: 1.25rem;
}
.pdoc h2 {
  font-family: var(--cfx-mono);
  color: var(--cfx-green);
  font-size: 1rem;
  font-weight: 600;
  letter-spacing: 0.02em;
  margin: 2rem 0 0.6rem;
}
.pdoc h3 {
  font-family: var(--cfx-mono);
  color: var(--cfx-cyan);
  font-size: 0.9rem;
  font-weight: 600;
  margin: 1.5rem 0 0.5rem;
}
.pdoc h4 {
  font-family: var(--cfx-mono);
  color: var(--cfx-orange);
  font-size: 0.875rem;
  font-weight: 600;
  margin: 1.25rem 0 0.4rem;
}

/* ── Body text ────────────────────────────────────────────────────────── */
.pdoc p         { color: var(--cfx-text); line-height: 1.75; }
.pdoc a         { color: var(--cfx-cyan); text-decoration: none; }
.pdoc a:hover   { color: var(--cfx-green); }
.pdoc strong    { color: var(--cfx-white); }
.pdoc em        { color: var(--cfx-mid);  font-style: italic; }
.pdoc ul, .pdoc ol { color: var(--cfx-text); }

/* ── Attribute / signature blocks ─────────────────────────────────────── */
.pdoc .attr {
  background: var(--cfx-panel);
  border: 1px solid var(--cfx-border);
  border-left: 3px solid var(--cfx-orange);
  border-radius: 2px;
  padding: 0.55rem 1rem;
  margin: 0.75rem 0 0;
  font-family: var(--cfx-mono);
  font-size: 13px;
  overflow-x: auto;
}
.pdoc .def    { color: var(--cfx-orange); font-weight: 600; }
.pdoc .name   { color: var(--cfx-green);  font-weight: 600; }
.pdoc .name.class { color: var(--cfx-cyan); }
.pdoc .param              { color: var(--cfx-text); }
.pdoc .param-annotation   { color: var(--cfx-dim);  }
.pdoc .param-default      { color: var(--cfx-mid);  }
.pdoc .return-annotation  { color: var(--cfx-dim);  }
.pdoc .signature { font-family: var(--cfx-mono); color: var(--cfx-text); }

/* ── Docstrings ───────────────────────────────────────────────────────── */
.pdoc .docstring {
  border-left: 2px solid var(--cfx-border-lit);
  padding: 0.5rem 0 0.5rem 1.25rem;
  margin: 0.6rem 0 1rem;
  color: var(--cfx-text);
}
.pdoc .docstring p { color: var(--cfx-text); }
.pdoc .docstring a { color: var(--cfx-cyan); }

/* Google-style section headings (Args:, Returns:, Raises:) */
.pdoc .docstring > section > h4 {
  color: var(--cfx-orange);
  font-size: 0.78rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  margin: 1rem 0 0.4rem;
  font-weight: 600;
}
.pdoc .docstring > section dt  { color: var(--cfx-cyan); font-weight: 600; }
.pdoc .docstring > section dd  { color: var(--cfx-mid); margin-left: 1.25rem; }

/* ── Code ─────────────────────────────────────────────────────────────── */
.pdoc code {
  font-family: var(--cfx-mono);
  font-size: 0.84em;
  color: var(--cfx-cyan);
  background: rgba(29, 252, 240, 0.07);
  border: 1px solid rgba(29, 252, 240, 0.14);
  padding: 0.1em 0.4em;
  border-radius: 2px;
}
.pdoc pre {
  background: var(--cfx-code-bg);
  border: 1px solid var(--cfx-border);
  border-left: 3px solid var(--cfx-green);
  border-radius: 2px;
  padding: 1rem 1.25rem;
  overflow-x: auto;
  margin: 1rem 0 1.25rem;
  font-family: var(--cfx-mono);
  font-size: 13px;
  line-height: 1.65;
}
.pdoc pre code {
  background: none;
  border: none;
  padding: 0;
  color: var(--cfx-text);
  font-size: inherit;
}

/* ── highlight.js → terminal palette ─────────────────────────────────── */
.hljs                    { background: var(--cfx-code-bg); color: var(--cfx-text); }
.hljs-keyword,
.hljs-built_in           { color: var(--cfx-orange); }
.hljs-string,
.hljs-number,
.hljs-literal            { color: var(--cfx-green); }
.hljs-comment            { color: var(--cfx-dim); font-style: italic; }
.hljs-title,
.hljs-class .hljs-title  { color: var(--cfx-cyan); font-weight: 600; }
.hljs-params             { color: var(--cfx-mid); }
.hljs-type               { color: var(--cfx-mid); }
.hljs-decorator,
.hljs-meta               { color: var(--cfx-orange); opacity: 0.85; }
.hljs-attr               { color: var(--cfx-cyan); }
.hljs-operator           { color: var(--cfx-dim); }
.hljs-punctuation        { color: var(--cfx-dim); }

/* ── Collapsible source blocks ────────────────────────────────────────── */
.pdoc details > summary {
  cursor: pointer;
  color: var(--cfx-dim);
  font-family: var(--cfx-mono);
  font-size: 11px;
  letter-spacing: 0.06em;
  padding: 0.3rem 0;
  user-select: none;
  list-style: none;
}
.pdoc details > summary::before { content: "[ source ]"; }
.pdoc details > summary::-webkit-details-marker { display: none; }
.pdoc details > summary:hover { color: var(--cfx-green); }
.pdoc details[open] > summary { color: var(--cfx-green); }

/* ── Type / label chips ───────────────────────────────────────────────── */
.pdoc .label {
  font-family: var(--cfx-mono);
  font-size: 9px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  border-radius: 2px;
  padding: 1px 5px;
  vertical-align: middle;
}
.pdoc .label.class    { color: var(--cfx-cyan);   border: 1px solid rgba(29,252,240,0.35); background: rgba(29,252,240,0.07); }
.pdoc .label.function { color: var(--cfx-green);  border: 1px solid rgba(127,255,95,0.35); background: rgba(127,255,95,0.07); }
.pdoc .label.property { color: var(--cfx-orange); border: 1px solid rgba(255,110,39,0.35); background: rgba(255,110,39,0.07); }
.pdoc .label.method   { color: var(--cfx-mid);    border: 1px solid var(--cfx-border); }

/* ── Inherited / cross-ref ────────────────────────────────────────────── */
.pdoc .inherited       { color: var(--cfx-dim); font-size: 0.85rem; }
.pdoc .inherited a     { color: var(--cfx-mid); }

/* ── Tables ───────────────────────────────────────────────────────────── */
.pdoc table {
  width: 100%;
  border-collapse: collapse;
  font-family: var(--cfx-mono);
  font-size: 13px;
  margin: 1rem 0 1.5rem;
}
.pdoc th {
  text-align: left;
  padding: 0.5rem 0.75rem;
  color: var(--cfx-green);
  border-bottom: 2px solid var(--cfx-border-lit);
  font-weight: 600;
}
.pdoc td {
  padding: 0.45rem 0.75rem;
  border-bottom: 1px solid var(--cfx-border);
  color: var(--cfx-text);
  vertical-align: top;
}
.pdoc tr:hover td { background: rgba(127,255,95,0.025); }

/* ── Blockquote ───────────────────────────────────────────────────────── */
.pdoc blockquote {
  border-left: 3px solid var(--cfx-orange);
  margin: 1.25rem 0;
  padding: 0.5rem 0 0.5rem 1.25rem;
  color: var(--cfx-mid);
  font-style: italic;
}

/* ── Admonition / note boxes ──────────────────────────────────────────── */
.pdoc .admonition {
  border: 1px solid var(--cfx-border-lit);
  border-left: 3px solid var(--cfx-cyan);
  background: rgba(29,252,240,0.04);
  padding: 0.75rem 1rem;
  border-radius: 2px;
  margin: 1.25rem 0;
  font-size: 14px;
}
.pdoc .admonition.warning { border-left-color: var(--cfx-orange); background: rgba(255,110,39,0.04); }
.pdoc .admonition.danger  { border-left-color: #ff4040; background: rgba(255,64,64,0.04); }
.pdoc .admonition-title   { font-weight: 600; color: var(--cfx-cyan); margin-bottom: 0.35rem; }
.pdoc .admonition.warning .admonition-title { color: var(--cfx-orange); }

/* ── Responsive ───────────────────────────────────────────────────────── */
@media (max-width: 720px) {
  :root { --cfx-bar-h: 36px; }
  #cfx-version-bar .cfx-links { display: none; }
  #cfx-version-bar .cfx-ver-label { display: none; }
}
</style>
{% endblock style %}

{# ── Nav: prepend fixed version bar ────────────────────────────────────────── #}
{% block nav %}
<div id="cfx-version-bar">
  <a class="cfx-logo" id="cfx-home-link" href="#">component-framework</a>
  <span class="cfx-badge" id="cfx-status-badge">BETA</span>
  <span class="cfx-sep">|</span>
  <span class="cfx-ver-label">version</span>
  <select id="cfx-version-select" title="Switch documentation version">
    <option value="">—</option>
  </select>
  <span class="cfx-links">
    <a href="https://github.com/fsecada01/component-framework" target="_blank" rel="noopener">GitHub ↗</a>
    <a href="https://pypi.org/project/component-framework/" target="_blank" rel="noopener">PyPI ↗</a>
  </span>
</div>
{{ super() }}
{% endblock nav %}

{# ── Script: version-switcher ───────────────────────────────────────────────── #}
{% block script %}
{{ super() }}
<script>
(function () {
  "use strict";

  /* ── Detect version from URL path ──────────────────────────────────────
   *
   * GitHub Pages URL:
   *   https://USER.github.io/REPO/VERSION/component_framework[/module].html
   *
   * pathParts example: ["", "component-framework", "main", "component_framework"]
   *   [0] = ""                         (leading slash)
   *   [1] = "component-framework"      (repo)
   *   [2] = "main" | "v0.2.0b0"       (version)
   *   [3] = "component_framework"      (package root or subdir)
   *
   * For local pdoc dev server the path starts with "component_framework"
   * at index 1 (no repo or version prefix) — we bail out gracefully.
   */
  var pathParts = window.location.pathname.split("/");
  var pkgIdx    = pathParts.indexOf("component_framework");

  /* Fix the home-link href using JS so it's correct at any nesting depth */
  var homeLink = document.getElementById("cfx-home-link");
  if (homeLink) {
    if (pkgIdx >= 2) {
      var repoRoot = window.location.origin + "/" + pathParts[1] + "/";
      homeLink.href = repoRoot;
    } else {
      /* local dev — link to pdoc root */
      homeLink.href = "/";
    }
  }

  if (pkgIdx < 2) {
    /* Local dev server: hide the version switcher but keep the bar */
    var sel = document.getElementById("cfx-version-select");
    var lbl = document.querySelector(".cfx-ver-label");
    var sep = document.querySelector(".cfx-sep");
    if (sel) sel.style.display = "none";
    if (lbl) lbl.style.display = "none";
    if (sep) sep.style.display = "none";
    var badge = document.getElementById("cfx-status-badge");
    if (badge) { badge.textContent = "DEV"; badge.className = "cfx-badge is-dev"; }
    return;
  }

  var repoSegment    = pathParts[1];
  var currentVersion = pathParts[pkgIdx - 1];
  var afterPkg       = pathParts.slice(pkgIdx).join("/");

  /* ── Status badge ────────────────────────────────────────────────────── */
  var badge = document.getElementById("cfx-status-badge");
  if (badge) {
    if (currentVersion === "main") {
      badge.textContent = "DEV";
      badge.className = "cfx-badge is-dev";
    } else if (/alpha/i.test(currentVersion)) {
      badge.textContent = "ALPHA";
      badge.className = "cfx-badge";              /* orange — default */
    } else if (/beta|b\d/i.test(currentVersion)) {
      badge.textContent = "BETA";
      badge.className = "cfx-badge";
    } else {
      badge.textContent = "STABLE";
      badge.className = "cfx-badge is-stable";
    }
  }

  /* ── Populate version select ─────────────────────────────────────────── */
  var versionsUrl =
    window.location.origin + "/" + repoSegment + "/versions.json";

  fetch(versionsUrl)
    .then(function (r) { return r.json(); })
    .then(function (data) {
      var sel = document.getElementById("cfx-version-select");
      if (!sel) return;
      sel.innerHTML = "";

      var entries = [];
      if (data.main) {
        entries.push({ value: "main", label: "main  (dev)" });
      }
      var releases = (data.versions || []).slice().reverse();
      releases.forEach(function (v) {
        entries.push({
          value: v,
          label: v === data.latest ? v + "  \u2605" : v
        });
      });

      entries.forEach(function (entry) {
        var opt      = document.createElement("option");
        opt.value    = entry.value;
        opt.textContent = entry.label;
        if (entry.value === currentVersion) opt.selected = true;
        sel.appendChild(opt);
      });

      sel.addEventListener("change", function () {
        window.location.href =
          window.location.origin +
          "/" + repoSegment +
          "/" + sel.value +
          "/" + afterPkg;
      });
    })
    .catch(function () {
      var sel = document.getElementById("cfx-version-select");
      if (sel) {
        sel.innerHTML = "";
        var opt = document.createElement("option");
        opt.textContent = currentVersion;
        sel.appendChild(opt);
      }
    });
})();
</script>
{% endblock script %}
