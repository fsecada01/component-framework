{% extends "default/frame.html.jinja2" %}

{#
  Custom frame template — "Terminal Modern" aesthetic.

  Keeps the terminal DNA (monospace chrome, "> " prompt, dark ground, code-first
  hierarchy) while using a palette modern developers recognise from VS Code, GitHub
  Dark, and Linear: soft emerald (#4ade80) instead of CRT chartreuse, warm amber
  instead of electric orange, sky blue instead of harsh cyan.

  Adds Inter as a body reading font alongside IBM Plex Mono for UI chrome.
  Version bar is position:fixed full-width regardless of sidebar DOM position.
#}

{# ── <head>: fonts ─────────────────────────────────────────────────────────── #}
{% block head %}
{{ super() }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,400;0,600;1,400&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
{% endblock head %}

{# ── CSS ───────────────────────────────────────────────────────────────────── #}
{% block style %}
{{ super() }}
<style>
/* ── Design tokens ─────────────────────────────────────────────────────── */
:root {
  /* Surfaces */
  --cfx-bg:         #0c1117;
  --cfx-panel:      #161c26;
  --cfx-panel-lit:  #1e2637;
  --cfx-code-bg:    #090e18;
  --cfx-border:     #1e2a3c;
  --cfx-border-lit: #29394f;

  /* Palette — softer, modern */
  --cfx-green:      #4ade80;   /* emerald-400  — primary */
  --cfx-green-dim:  rgba(74, 222, 128, 0.12);
  --cfx-amber:      #fbbf24;   /* amber-400    — accent / prompt */
  --cfx-amber-dim:  rgba(251, 191, 36, 0.10);
  --cfx-sky:        #38bdf8;   /* sky-400      — secondary */
  --cfx-sky-dim:    rgba(56, 189, 248, 0.10);
  --cfx-violet:     #a78bfa;   /* violet-400   — special */

  /* Text */
  --cfx-text:       #cbd5e1;
  --cfx-muted:      #64748b;
  --cfx-dim:        #334155;
  --cfx-white:      #f1f5f9;

  /* Typography */
  --cfx-mono:       'IBM Plex Mono', 'Courier New', monospace;
  --cfx-sans:       'Inter', system-ui, -apple-system, sans-serif;

  /* Geometry */
  --cfx-bar-h:      42px;
  --cfx-radius:     4px;
  --cfx-radius-sm:  2px;

  /* pdoc override */
  --pdoc-background: var(--cfx-bg);
}

/* ── Base ──────────────────────────────────────────────────────────────── */
html { scroll-behavior: smooth; }
body {
  background: var(--cfx-bg);
  color: var(--cfx-text);
  font-family: var(--cfx-sans);
  padding-top: var(--cfx-bar-h);
}

/* ── Scrollbar ─────────────────────────────────────────────────────────── */
::-webkit-scrollbar              { width: 5px; height: 5px; }
::-webkit-scrollbar-track        { background: transparent; }
::-webkit-scrollbar-thumb        { background: var(--cfx-border-lit); border-radius: 3px; }
::-webkit-scrollbar-thumb:hover  { background: var(--cfx-muted); }
*                                { scrollbar-width: thin; scrollbar-color: var(--cfx-border-lit) transparent; }

/* ═══════════════════════════════════════════════════════════════════════
   VERSION BAR — fixed, full-width, above sidebar and content
   ═══════════════════════════════════════════════════════════════════════ */
#cfx-version-bar {
  position: fixed;
  top: 0; left: 0; right: 0;
  height: var(--cfx-bar-h);
  z-index: 1000;
  display: flex;
  align-items: center;
  padding: 0 1.25rem;
  gap: 0;
  /* subtle directional gradient — darker on left, lifts slightly right */
  background: linear-gradient(to right, #1a2232 0%, var(--cfx-panel) 60%);
  border-bottom: 1px solid var(--cfx-border);
  font-family: var(--cfx-mono);
  font-size: 11px;
  color: var(--cfx-muted);
  white-space: nowrap;
  overflow: hidden;
}

/* Logo */
#cfx-version-bar .cfx-logo {
  color: var(--cfx-green);
  font-weight: 600;
  font-size: 13px;
  text-decoration: none;
  letter-spacing: 0.02em;
  flex-shrink: 0;
  margin-right: 0.85rem;
  transition: color 0.15s;
}
#cfx-version-bar .cfx-logo::before { content: "> "; color: var(--cfx-amber); }
#cfx-version-bar .cfx-logo:hover   { color: var(--cfx-white); }

/* Status badge */
#cfx-version-bar .cfx-badge {
  font-family: var(--cfx-mono);
  font-size: 9px;
  letter-spacing: 0.12em;
  border-radius: var(--cfx-radius-sm);
  padding: 2px 6px;
  flex-shrink: 0;
  margin-right: 0.85rem;
  /* default: amber for alpha/beta */
  color: var(--cfx-amber);
  border: 1px solid rgba(251, 191, 36, 0.4);
  background: rgba(251, 191, 36, 0.06);
}
#cfx-version-bar .cfx-badge.is-dev    { color: var(--cfx-sky);   border-color: rgba(56,189,248,0.4); background: rgba(56,189,248,0.06); }
#cfx-version-bar .cfx-badge.is-stable { color: var(--cfx-green); border-color: rgba(74,222,128,0.4); background: rgba(74,222,128,0.06); }

/* Sep */
#cfx-version-bar .cfx-sep { color: var(--cfx-border-lit); margin: 0 0.7rem; flex-shrink: 0; }

/* Version label + select */
#cfx-version-bar .cfx-ver-label { color: var(--cfx-dim); margin-right: 0.4rem; flex-shrink: 0; }
#cfx-version-bar select {
  font-family: var(--cfx-mono);
  font-size: 11px;
  color: var(--cfx-text);
  background: rgba(255,255,255,0.04);
  border: 1px solid var(--cfx-border-lit);
  border-radius: var(--cfx-radius-sm);
  padding: 2px 8px 2px 6px;
  cursor: pointer;
  outline: none;
  appearance: none;
  -webkit-appearance: none;
  flex-shrink: 0;
  max-width: 160px;
  transition: border-color 0.15s, box-shadow 0.15s;
}
#cfx-version-bar select:focus {
  border-color: var(--cfx-green);
  box-shadow: 0 0 0 2px rgba(74, 222, 128, 0.15);
}

/* Right links */
#cfx-version-bar .cfx-links {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 1.1rem;
  flex-shrink: 0;
}
#cfx-version-bar .cfx-links a {
  color: var(--cfx-muted);
  text-decoration: none;
  font-size: 11px;
  letter-spacing: 0.03em;
  transition: color 0.15s;
}
#cfx-version-bar .cfx-links a:hover { color: var(--cfx-green); }
#cfx-version-bar .cfx-links .cfx-link-api { color: var(--cfx-sky); }
#cfx-version-bar .cfx-links .cfx-link-api:hover { color: var(--cfx-green); }

/* ═══════════════════════════════════════════════════════════════════════
   SIDEBAR
   ═══════════════════════════════════════════════════════════════════════ */
nav#sidebar {
  background: var(--cfx-panel);
  border-right: 1px solid var(--cfx-border);
  font-family: var(--cfx-mono);
  top: var(--cfx-bar-h);
  max-height: calc(100vh - var(--cfx-bar-h));
}

nav#sidebar a                           { color: var(--cfx-muted); text-decoration: none; }
nav#sidebar a:hover, nav#sidebar a:focus { color: var(--cfx-green); }

nav#sidebar h2, nav#sidebar h3 {
  font-family: var(--cfx-mono);
  font-size: 9px;
  color: var(--cfx-dim);
  letter-spacing: 0.18em;
  text-transform: uppercase;
  margin: 1.1rem 0 0.4rem;
}

/* Search */
nav#sidebar input[type=search] {
  font-family: var(--cfx-sans);
  font-size: 12px;
  background: rgba(255,255,255,0.04);
  color: var(--cfx-text);
  border: 1px solid var(--cfx-border);
  border-radius: var(--cfx-radius);
  padding: 5px 10px;
  outline: none;
  width: 100%;
  box-sizing: border-box;
  transition: border-color 0.15s, box-shadow 0.15s;
}
nav#sidebar input[type=search]:focus {
  border-color: var(--cfx-green);
  box-shadow: 0 0 0 2px rgba(74, 222, 128, 0.12);
}
nav#sidebar input[type=search]::placeholder { color: var(--cfx-dim); }

/* Nav items */
nav#sidebar ul                   { list-style: none; padding: 0; margin: 0; }
nav#sidebar li                   { margin: 0; }
nav#sidebar li > a {
  display: block;
  padding: 0.28rem 1rem;
  font-size: 12px;
  border-left: 2px solid transparent;
  border-radius: 0 var(--cfx-radius-sm) var(--cfx-radius-sm) 0;
  transition: color 0.12s, border-color 0.12s, background 0.12s;
}
nav#sidebar li > a:hover {
  color: var(--cfx-green);
  border-left-color: var(--cfx-green);
  background: var(--cfx-green-dim);
}

nav#sidebar .module-list-button {
  color: var(--cfx-amber);
  border-color: var(--cfx-border-lit);
  background: transparent;
  font-family: var(--cfx-mono);
  font-size: 11px;
  border-radius: var(--cfx-radius-sm);
}

/* ═══════════════════════════════════════════════════════════════════════
   CONTENT
   ═══════════════════════════════════════════════════════════════════════ */
main#content { background: var(--cfx-bg); }

/* ── Headings ──────────────────────────────────────────────────────────── */
.pdoc h1 {
  font-family: var(--cfx-mono);
  color: var(--cfx-white);
  font-size: 1.5rem;
  font-weight: 600;
  border-bottom: 1px solid var(--cfx-border);
  padding-bottom: 0.65rem;
  margin-bottom: 1.25rem;
}
.pdoc h2 {
  font-family: var(--cfx-mono);
  color: var(--cfx-green);
  font-size: 1rem;
  font-weight: 600;
  letter-spacing: 0.02em;
  margin: 2.25rem 0 0.65rem;
}
.pdoc h3 {
  font-family: var(--cfx-mono);
  color: var(--cfx-sky);
  font-size: 0.9rem;
  font-weight: 600;
  margin: 1.5rem 0 0.5rem;
}
.pdoc h4 {
  font-family: var(--cfx-mono);
  color: var(--cfx-amber);
  font-size: 0.875rem;
  font-weight: 600;
  margin: 1.25rem 0 0.4rem;
}

/* ── Body text ─────────────────────────────────────────────────────────── */
.pdoc p      { font-family: var(--cfx-sans); color: var(--cfx-text); line-height: 1.78; }
.pdoc ul,
.pdoc ol     { font-family: var(--cfx-sans); color: var(--cfx-text); line-height: 1.7; }
.pdoc a      { color: var(--cfx-sky); text-decoration: none; transition: color 0.12s; }
.pdoc a:hover { color: var(--cfx-green); }
.pdoc strong  { color: var(--cfx-white); font-weight: 600; }
.pdoc em      { color: var(--cfx-muted); font-style: italic; }

/* ── Attribute / signature blocks ──────────────────────────────────────── */
.pdoc .attr {
  background: var(--cfx-panel);
  border: 1px solid var(--cfx-border);
  border-left: 3px solid var(--cfx-amber);
  border-radius: var(--cfx-radius);
  padding: 0.6rem 1rem;
  margin: 0.85rem 0 0;
  font-family: var(--cfx-mono);
  font-size: 13px;
  overflow-x: auto;
  transition: border-left-color 0.15s, box-shadow 0.15s;
}
.pdoc .attr:hover {
  border-left-color: var(--cfx-green);
  box-shadow: 0 2px 12px rgba(0,0,0,0.25);
}
.pdoc .def               { color: var(--cfx-amber); font-weight: 600; }
.pdoc .name              { color: var(--cfx-green); font-weight: 600; }
.pdoc .name.class        { color: var(--cfx-sky); }
.pdoc .param             { color: var(--cfx-text); }
.pdoc .param-annotation  { color: var(--cfx-muted); }
.pdoc .param-default     { color: var(--cfx-dim); }
.pdoc .return-annotation { color: var(--cfx-muted); }
.pdoc .signature         { font-family: var(--cfx-mono); color: var(--cfx-text); }

/* ── Docstrings ─────────────────────────────────────────────────────────── */
.pdoc .docstring {
  border-left: 2px solid var(--cfx-border-lit);
  padding: 0.5rem 0 0.5rem 1.25rem;
  margin: 0.65rem 0 1rem;
}
.pdoc .docstring p    { font-family: var(--cfx-sans); color: var(--cfx-text); }
.pdoc .docstring a    { color: var(--cfx-sky); }
.pdoc .docstring ul,
.pdoc .docstring ol   { font-family: var(--cfx-sans); }

/* Google-style sections (Args, Returns, Raises) */
.pdoc .docstring > section > h4 {
  font-family: var(--cfx-mono);
  color: var(--cfx-amber);
  font-size: 0.78rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  margin: 1rem 0 0.4rem;
  font-weight: 600;
}
.pdoc .docstring > section dt { color: var(--cfx-sky); font-weight: 600; }
.pdoc .docstring > section dd { color: var(--cfx-muted); margin-left: 1.25rem; font-family: var(--cfx-sans); }

/* ── Code ───────────────────────────────────────────────────────────────── */
.pdoc code {
  font-family: var(--cfx-mono);
  font-size: 0.84em;
  color: var(--cfx-sky);
  background: var(--cfx-sky-dim);
  border: 1px solid rgba(56, 189, 248, 0.15);
  padding: 0.1em 0.4em;
  border-radius: var(--cfx-radius-sm);
}
.pdoc pre {
  background: var(--cfx-code-bg);
  border: 1px solid var(--cfx-border);
  border-left: 3px solid var(--cfx-green);
  border-radius: var(--cfx-radius);
  padding: 1.1rem 1.25rem;
  overflow-x: auto;
  margin: 1rem 0 1.25rem;
  font-family: var(--cfx-mono);
  font-size: 13px;
  line-height: 1.65;
  box-shadow: 0 4px 16px rgba(0,0,0,0.3);
}
.pdoc pre code {
  background: none;
  border: none;
  padding: 0;
  color: var(--cfx-text);
  font-size: inherit;
}

/* ── highlight.js → Terminal Modern palette ─────────────────────────────── */
.hljs                     { background: var(--cfx-code-bg); color: var(--cfx-text); }
.hljs-keyword,
.hljs-built_in            { color: var(--cfx-amber); }
.hljs-string,
.hljs-number,
.hljs-literal             { color: var(--cfx-green); }
.hljs-comment             { color: var(--cfx-dim); font-style: italic; }
.hljs-title,
.hljs-class .hljs-title   { color: var(--cfx-sky); font-weight: 600; }
.hljs-params              { color: var(--cfx-muted); }
.hljs-type                { color: var(--cfx-violet); }
.hljs-decorator,
.hljs-meta                { color: var(--cfx-amber); opacity: 0.9; }
.hljs-attr,
.hljs-variable            { color: var(--cfx-sky); }
.hljs-operator,
.hljs-punctuation         { color: var(--cfx-muted); }
.hljs-regexp              { color: var(--cfx-green); }

/* ── Source toggle ──────────────────────────────────────────────────────── */
.pdoc details > summary {
  cursor: pointer;
  color: var(--cfx-dim);
  font-family: var(--cfx-mono);
  font-size: 11px;
  letter-spacing: 0.06em;
  padding: 0.3rem 0;
  user-select: none;
  list-style: none;
  transition: color 0.12s;
}
.pdoc details > summary::before          { content: "[ source ]"; }
.pdoc details > summary::-webkit-details-marker { display: none; }
.pdoc details > summary:hover            { color: var(--cfx-green); }
.pdoc details[open] > summary           { color: var(--cfx-green); }

/* ── Labels ─────────────────────────────────────────────────────────────── */
.pdoc .label {
  font-family: var(--cfx-mono);
  font-size: 9px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  border-radius: var(--cfx-radius-sm);
  padding: 2px 6px;
  vertical-align: middle;
}
.pdoc .label.class    { color: var(--cfx-sky);    border: 1px solid rgba(56,189,248,0.35);  background: rgba(56,189,248,0.07);  }
.pdoc .label.function { color: var(--cfx-green);  border: 1px solid rgba(74,222,128,0.35);  background: rgba(74,222,128,0.07);  }
.pdoc .label.property { color: var(--cfx-amber);  border: 1px solid rgba(251,191,36,0.35);  background: rgba(251,191,36,0.07);  }
.pdoc .label.method   { color: var(--cfx-violet); border: 1px solid rgba(167,139,250,0.35); background: rgba(167,139,250,0.07); }

/* ── Tables ─────────────────────────────────────────────────────────────── */
.pdoc table {
  width: 100%;
  border-collapse: collapse;
  font-family: var(--cfx-sans);
  font-size: 13.5px;
  margin: 1rem 0 1.5rem;
}
.pdoc th {
  text-align: left;
  padding: 0.55rem 0.85rem;
  color: var(--cfx-green);
  font-family: var(--cfx-mono);
  font-size: 11px;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  border-bottom: 2px solid var(--cfx-border-lit);
  font-weight: 600;
}
.pdoc td {
  padding: 0.5rem 0.85rem;
  border-bottom: 1px solid var(--cfx-border);
  color: var(--cfx-text);
  vertical-align: top;
}
.pdoc tr:hover td { background: rgba(74, 222, 128, 0.025); }

/* ── Blockquote ─────────────────────────────────────────────────────────── */
.pdoc blockquote {
  border-left: 3px solid var(--cfx-amber);
  background: var(--cfx-amber-dim);
  border-radius: 0 var(--cfx-radius) var(--cfx-radius) 0;
  margin: 1.25rem 0;
  padding: 0.65rem 1.25rem;
  color: var(--cfx-muted);
  font-family: var(--cfx-sans);
}

/* ── Admonitions ────────────────────────────────────────────────────────── */
.pdoc .admonition {
  border: 1px solid var(--cfx-border-lit);
  border-left: 3px solid var(--cfx-sky);
  background: var(--cfx-sky-dim);
  padding: 0.85rem 1.1rem;
  border-radius: var(--cfx-radius);
  margin: 1.25rem 0;
  font-family: var(--cfx-sans);
}
.pdoc .admonition.warning { border-left-color: var(--cfx-amber); background: var(--cfx-amber-dim); }
.pdoc .admonition.danger  { border-left-color: #f87171; background: rgba(248,113,113,0.05); }
.pdoc .admonition-title   { font-family: var(--cfx-mono); font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 600; color: var(--cfx-sky); margin-bottom: 0.4rem; }
.pdoc .admonition.warning .admonition-title { color: var(--cfx-amber); }
.pdoc .admonition.danger  .admonition-title { color: #f87171; }

/* ── Inherited ──────────────────────────────────────────────────────────── */
.pdoc .inherited     { color: var(--cfx-dim); font-size: 0.85rem; }
.pdoc .inherited a   { color: var(--cfx-muted); }

/* ── Responsive ─────────────────────────────────────────────────────────── */
@media (max-width: 720px) {
  :root { --cfx-bar-h: 38px; }
  #cfx-version-bar .cfx-links .cfx-link-ext { display: none; }
  #cfx-version-bar .cfx-ver-label { display: none; }
}
</style>
{% endblock style %}

{# ── Nav block ─────────────────────────────────────────────────────────────── #}
{% block nav %}
<div id="cfx-version-bar">
  <a class="cfx-logo" id="cfx-home-link" href="#">component-framework</a>
  <span class="cfx-badge" id="cfx-status-badge">BETA</span>
  <span class="cfx-sep">|</span>
  <span class="cfx-ver-label">version</span>
  <select id="cfx-version-select" title="Switch documentation version">
    <option value="">—</option>
  </select>
  <span class="cfx-links">
    <a href="#" id="cfx-link-home">Home</a>
    <a href="#" id="cfx-link-example">Example</a>
    <a href="#" id="cfx-link-api" class="cfx-link-api">API Ref</a>
    <a href="https://github.com/fsecada01/component-framework" target="_blank" rel="noopener" class="cfx-link-ext">GitHub ↗</a>
    <a href="https://pypi.org/project/component-framework/" target="_blank" rel="noopener" class="cfx-link-ext">PyPI ↗</a>
  </span>
</div>
{{ super() }}
{% endblock nav %}

{# ── Script block ──────────────────────────────────────────────────────────── #}
{% block script %}
{{ super() }}
<script>
(function () {
  "use strict";

  var pathParts      = window.location.pathname.split("/");
  var REPO           = "component-framework";
  var repoIdx        = pathParts.indexOf(REPO);
  var isLocal        = repoIdx < 0;
  var repoSegment    = REPO;
  var currentVersion = isLocal ? "local" : (pathParts[repoIdx + 1] || "main");
  // Path within the version dir — used by version switcher to keep the same page.
  // Falls back to component_framework.html (the package root) when at the version root.
  var afterPkg       = isLocal
    ? "component_framework.html"
    : (pathParts.slice(repoIdx + 2).join("/") || "component_framework.html");

  /* ── Compute base URLs ─────────────────────────────────────────────────── */
  var baseUrl = isLocal
    ? "/"
    : window.location.origin + "/" + repoSegment + "/" + currentVersion + "/";

  /* Set all nav hrefs */
  var homeEl    = document.getElementById("cfx-home-link");
  var linkHome  = document.getElementById("cfx-link-home");
  var linkEx    = document.getElementById("cfx-link-example");
  var linkApi   = document.getElementById("cfx-link-api");
  var repoRoot  = isLocal ? "/" : window.location.origin + "/" + repoSegment + "/";

  if (homeEl)   homeEl.href   = repoRoot;
  if (linkHome) linkHome.href = baseUrl + "index.html";
  if (linkEx)   linkEx.href   = baseUrl + "ecommerce.html";
  if (linkApi)  linkApi.href  = baseUrl + "component_framework.html";

  /* ── Hide version UI on local dev ─────────────────────────────────────── */
  if (isLocal) {
    var sel = document.getElementById("cfx-version-select");
    var lbl = document.querySelector(".cfx-ver-label");
    var sep = document.querySelector("#cfx-version-bar .cfx-sep");
    if (sel) sel.style.display = "none";
    if (lbl) lbl.style.display = "none";
    if (sep) sep.style.display = "none";
    var badge = document.getElementById("cfx-status-badge");
    if (badge) { badge.textContent = "DEV"; badge.className = "cfx-badge is-dev"; }
    return;
  }

  /* ── Status badge ──────────────────────────────────────────────────────── */
  var badge = document.getElementById("cfx-status-badge");
  if (badge) {
    if (currentVersion === "main") {
      badge.textContent = "DEV"; badge.className = "cfx-badge is-dev";
    } else if (/alpha/i.test(currentVersion)) {
      badge.textContent = "ALPHA"; badge.className = "cfx-badge";
    } else if (/beta|b\d/i.test(currentVersion)) {
      badge.textContent = "BETA"; badge.className = "cfx-badge";
    } else {
      badge.textContent = "STABLE"; badge.className = "cfx-badge is-stable";
    }
  }

  /* ── Version switcher ──────────────────────────────────────────────────── */
  var versionsUrl = window.location.origin + "/" + repoSegment + "/versions.json";
  fetch(versionsUrl)
    .then(function (r) { return r.json(); })
    .then(function (data) {
      var sel = document.getElementById("cfx-version-select");
      if (!sel) return;
      sel.innerHTML = "";
      var entries = [];
      if (data.main) entries.push({ value: "main", label: "main  (dev)" });
      (data.versions || []).slice().reverse().forEach(function (v) {
        entries.push({ value: v, label: v === data.latest ? v + "  \u2605" : v });
      });
      entries.forEach(function (e) {
        var opt = document.createElement("option");
        opt.value = e.value;
        opt.textContent = e.label;
        if (e.value === currentVersion) opt.selected = true;
        sel.appendChild(opt);
      });
      sel.addEventListener("change", function () {
        window.location.href =
          window.location.origin + "/" + repoSegment + "/" + sel.value + "/" + afterPkg;
      });
    })
    .catch(function () {
      var sel = document.getElementById("cfx-version-select");
      if (!sel) return;
      sel.innerHTML = "";
      var opt = document.createElement("option");
      opt.textContent = currentVersion;
      sel.appendChild(opt);
    });
})();
</script>
{% endblock script %}
